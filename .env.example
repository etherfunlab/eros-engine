# eros-engine .env.example — one line per variable. Commented lines are
# optional; a value shown on a commented line is the built-in default.
# Details live in the docs, not here:
#   docs/deploying.md      — deploy paths, auth, sweepers, operational notes
#   docs/model-config.md   — models, tasks, [providers] routing
#   docs/api-reference.md  — API surface, usage filtering

# ── Postgres (engine schema only) ────────────────────────────────────────────
DATABASE_URL=postgres://postgres:<password>@<host>:5432/postgres

# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
# Usage keys hidden from API clients (docs/api-reference.md).
# OPENROUTER_USAGE_HIDDEN_KEYS=cost,cost_details

# ── Custom providers — [providers] block (docs/model-config.md) ──────────────
# One `<NAME>_API_KEY` per entry, name uppercased: [providers].venice →
# VENICE_API_KEY=

# ── Supabase auth (docs/deploying.md → Bring-your-own auth) ──────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWKS_URL=
# Legacy HS256 secret; empty counts as unset.
SUPABASE_JWT_SECRET=

# ── Voyage embeddings ─────────────────────────────────────────────────────────
# Required unless [tasks.embedding] routes BOTH read and write off Voyage.
VOYAGE_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info
EXPOSE_AFFINITY_DEBUG=true
EMA_INERTIA=0.5
DEMO_EMA_INERTIA=0.3
# Exactly one of the two model-config sources (docs/model-config.md).
MODEL_CONFIG_PATH=examples/model_config.toml
# MODEL_CONFIG_DIR=/etc/eros/model.d
# Prompt-assembly debug log (docs/deploying.md → Prompt logging).
# PROMPT_LOG_DIR=/data/prompt-logs

# ── Background sweepers (docs/deploying.md → Operational notes) ──────────────
# DREAMING_DISABLED=false
# DREAMING_TICK_SECS=300
# DREAMING_IDLE_SECS=1800
# DREAMING_CLAIM_STALE_SECS=600
# Opt out of post-call voice memory ingestion (docs/memory-layers.md → Voice
# turns). Default off: ended voice calls ARE distilled into profile memories.
# DREAMING_VOICE_DISABLED=false
# SNAPSHOT_DISABLED=false
# SNAPSHOT_CRON=0 0 23 * * *
# SNAPSHOT_TZ=Asia/Singapore

# ── World system (experimental; docs/deploying.md → World system) ────────────
# WORLD_DISABLED=false
# WORLD_PROMPT_DISABLED=false
# WORLD_TOWN_DISABLED=false
# WORLD_STORIES_DISABLED=false
# WORLD_STORIES_PROMPT_DISABLED=false
# WORLD_TICK_SECS=300
